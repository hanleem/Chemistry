# --- Server config ---
# Port the Express server listens on
PORT=3000

# JWT 서명에 쓰는 비밀키. 반드시 길고 랜덤한 값으로 바꿀 것.
# 예: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# 운영 환경에서만 https 쿠키 강제(NODE_ENV=production일 때 자동). HTTPS 미사용 서버라면 0으로.
NODE_ENV=production
COOKIE_SECURE=1

# SQLite 파일 경로 (기본: server/data/chem.db). 절대경로 권장.
# DB_PATH=/var/lib/chem-app/chem.db

# --- 첫 관리자 계정 시드 ---
# 서버가 처음 부팅될 때 이 학번/비번으로 관리자 계정을 생성합니다.
# 이미 같은 학번이 있으면 role만 admin으로 승격합니다.
ADMIN_ID=admin
ADMIN_PW=please-change-me
ADMIN_NAME=관리자

# --- (선택) CORS ---
# client와 server를 다른 도메인으로 분리해 운영할 때만 사용. 같은 origin이면 비워두세요.
# CORS_ORIGIN=https://chem.example.ac.kr
