# /etc/nginx/sites-available/chem-app
# (선택) Nginx를 80/443에서 받아 Express(3000)로 리버스 프록시할 때 사용.
# Express 단독으로 직접 노출하려면 이 파일은 필요 없습니다.

server {
    listen 80;
    server_name chem.example.ac.kr;

    # HTTPS로 리다이렉트하려면 아래 두 줄 주석 해제 후 https 블록 사용
    # return 301 https://$host$request_uri;

    client_max_body_size 1m;

    location / {
        proxy_pass         http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}

# server {
#     listen 443 ssl http2;
#     server_name chem.example.ac.kr;
#     ssl_certificate     /etc/letsencrypt/live/chem.example.ac.kr/fullchain.pem;
#     ssl_certificate_key /etc/letsencrypt/live/chem.example.ac.kr/privkey.pem;
#     # ... 위 location 블록 동일하게 ...
# }
