[Unit]
Description=Chem-Nano Pathway App (Express + SQLite)
After=network.target

[Service]
Type=simple
# 실제 배포 경로/사용자로 수정하세요
User=chem
WorkingDirectory=/srv/chem-app/server
EnvironmentFile=/srv/chem-app/.env
ExecStart=/usr/bin/node /srv/chem-app/server/index.js
Restart=on-failure
RestartSec=3
# 로그는 journalctl -u chem-app 로 확인
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
